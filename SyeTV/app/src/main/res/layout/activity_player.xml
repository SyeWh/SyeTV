<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Video surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Buffering indicator -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- Bottom controls overlay -->
    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/overlay_bg"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <!-- Title row -->
        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="14dp" />

        <!-- Seek bar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:thumbTint="@color/white"
            android:progressTint="@color/white"
            android:secondaryProgressTint="@color/text_secondary"
            android:layout_marginBottom="10dp" />

        <!-- Time + quality row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="0:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Quality button (Drive only) -->
            <TextView
                android:id="@+id/tvQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/card_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="0:00" />

        </LinearLayout>

    </LinearLayout>

    <!-- Center play/pause flash -->
    <FrameLayout
        android:id="@+id/playPauseFlash"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="#80000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPlayPauseIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="▶"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:gravity="center" />

    </FrameLayout>

    <!-- Seek flash (left) -->
    <TextView
        android:id="@+id/tvSeekBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="80dp"
        android:text="⏮ 10s"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="#80000000"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- Seek flash (right) -->
    <TextView
        android:id="@+id/tvSeekFwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="80dp"
        android:text="10s ⏭"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="#80000000"
        android:padding="12dp"
        android:visibility="gone" />

</FrameLayout>
